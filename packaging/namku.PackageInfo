name			namku
version			0.5.0-3
architecture	x86_64
summary			"NAMku - Neural Amp Modeler: VST3 plug-in and standalone app (RenkuOS)"
description		"A Neural Amp Modeler (NAM) player: loads .nam amp/pedal captures and
impulse-response .wav files. As a native VST3 plug-in for hosts such as JackDAW,
and as the standalone NAMku app (Applications menu), which plays on the Media
Kit or, with the jack package installed, on JACK. Vendors NeuralAmpModelerCore
and AudioDSPTools (MIT) and Eigen (MPL 2.0); the Steinberg VST3 SDK is linked
statically (MIT)."
packager		"rations <ehqcar@proton.me>"
vendor			"rations"
copyrights {
	"2026 rations"
	"Steven Atkinson (NeuralAmpModelerCore, AudioDSPTools)"
	"2025 Steinberg Media Technologies GmbH"
}
licenses {
	"MIT"
	"MPL v2.0"
}
provides {
	namku = 0.5.0
	app:NAMku = 0.5.0
}
requires {
	haiku
	libsamplerate
}
urls {
	"https://github.com/rations/NAMku"
}
