/*
 * NAMku standalone app resources: signature, launch behaviour and version.
 * Compiled with rc and attached with xres by CMakeLists.txt.
 */

resource app_signature "application/x-vnd.rations-NAMku";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 5,
	minor  = 0,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "NAMku",
	long_info = "NAMku 0.5.0, Neural Amp Modeler player for the Media Kit or JACK"
};
